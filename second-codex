#!/usr/bin/env bash
set -euo pipefail

ROOT="${SECOND_CODEX_SWITCH_ROOT:-$HOME/.codex-account-switch}"
A_HOME="${CODEX_A_HOME:-$HOME/.codex}"
B_HOME="${SECOND_CODEX_HOME:-$HOME/.codex-second}"
BIN_DIR="${SECOND_CODEX_SHIM_DIR:-${TMPDIR:-/tmp}/second-codex-shim-$(id -u)}"
A_HOME="${A_HOME%/}"
B_HOME="${B_HOME%/}"
BIN_DIR="${BIN_DIR%/}"
WRAPPER_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REAL_CODEX="${SECOND_CODEX_SWITCH_REAL_CODEX:-$(command -v codex || true)}"

ACCOUNT_PATTERNS=()
ENVIRONMENT_PATTERNS=()

block_reason() {
  cat >&2 <<'EOF'
second-codex refused this account/auth command.
Run account/auth changes explicitly from the intended Codex account.
EOF
}

find_manifest() {
  local script_dir
  script_dir="$(cd "$(dirname "$WRAPPER_PATH")" && pwd)"
  local candidates=(
    "${SECOND_CODEX_MANIFEST:-}"
    "$ROOT/ownership-manifest.txt"
    "$script_dir/ownership-manifest.txt"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

load_manifest() {
  local manifest section line
  if ! manifest="$(find_manifest)"; then
    echo "second-codex missing ownership manifest" >&2
    return 66
  fi

  ACCOUNT_PATTERNS=()
  ENVIRONMENT_PATTERNS=()
  section=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    case "$line" in
      '['*']')
        section="${line#[}"
        section="${section%]}"
        ;;
      *)
        case "$section" in
          account-runtime|shared-by-reference)
            ACCOUNT_PATTERNS+=("$line")
            ;;
          primary-owned-environment)
            ENVIRONMENT_PATTERNS+=("$line")
            ;;
        esac
        ;;
    esac
  done < "$manifest"

  if (( ${#ACCOUNT_PATTERNS[@]} == 0 || ${#ENVIRONMENT_PATTERNS[@]} == 0 )); then
    echo "second-codex ownership manifest did not define required pattern groups: $manifest" >&2
    return 66
  fi
}

matches_any_pattern() {
  local value="$1"
  shift
  local pattern normalized
  for pattern in "$@"; do
    normalized="${pattern%/}"
    [[ "$value" == $pattern ]] && return 0
    [[ "$value" == $normalized ]] && return 0
  done
  return 1
}

unknown_entries() {
  local home="$1"
  [[ -d "$home" ]] || return 0
  local path name
  while IFS= read -r path; do
    name="${path##*/}"
    matches_any_pattern "$name" "${ACCOUNT_PATTERNS[@]}" && continue
    matches_any_pattern "$name" "${ENVIRONMENT_PATTERNS[@]}" && continue
    printf '%s\n' "$name"
  done < <(find "$home" -mindepth 1 -maxdepth 1 -print | sort)
}

fail_on_unknown_entries() {
  local label="$1"
  local home="$2"
  local unknown
  unknown="$(unknown_entries "$home")"
  [[ -z "$unknown" ]] && return 0
  {
    echo "second-codex refused to sync because $label CODEX_HOME has unknown top-level entries:"
    printf '%s\n' "$unknown" | sed 's/^/  - /'
    echo "Classify these in ownership-manifest.txt before syncing."
  } >&2
  return 65
}

ensure_shared_path() {
  local name="$1"
  local target="$A_HOME/$name"
  local link="$B_HOME/$name"

  if [[ -e "$target" && ! -d "$target" ]]; then
    echo "second-codex refused shared path because primary $target is not a directory." >&2
    return 73
  fi
  mkdir -p "$target" "$B_HOME"
  if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
    return 0
  fi
  if [[ -e "$link" || -L "$link" ]]; then
    echo "second-codex refused to replace existing $link; move it aside, then rerun." >&2
    return 73
  fi
  ln -s "$target" "$link"
}

ensure_shared_paths() {
  ensure_shared_path memories
  ensure_shared_path memories_extensions
}

reroute_notice() {
  printf 'second-codex: rerouting environment/config change to primary CODEX_HOME: %s\n' "$A_HOME" >&2
}

is_valid_session_id() {
  [[ "$1" =~ ^[0-9A-Fa-f-]{36}$ ]]
}

refuse_symlink_home() {
  local label="$1"
  local home="$2"
  if [[ -L "$home" ]]; then
    echo "second-codex refused symlinked $label CODEX_HOME: $home" >&2
    return 73
  fi
}

home_has_environment_sentinel() {
  local home="$1"
  local path name
  [[ -d "$home" ]] || return 1
  while IFS= read -r path; do
    name="${path##*/}"
    matches_any_pattern "$name" "${ENVIRONMENT_PATTERNS[@]}" && return 0
  done < <(find "$home" -mindepth 1 -maxdepth 1 -print | sort)
  return 1
}

fail_if_primary_has_no_environment() {
  if home_has_environment_sentinel "$A_HOME"; then
    return 0
  fi
  cat >&2 <<EOF
second-codex refused destructive projection because primary CODEX_HOME has no environment entries: $A_HOME
Set up primary Codex first, or check CODEX_A_HOME.
EOF
  return 65
}

classify_command() {
  local has_mcp=0 has_plugin=0 has_managed=0 has_features=0 has_trust=0 has_config=0
  local has_login=0 has_status=0 has_logout=0 has_auth=0 has_oauth=0 has_token=0 has_refresh=0
  local has_update=0 has_upgrade=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      mcp) has_mcp=1 ;;
      plugin|plugins) has_plugin=1; has_managed=1 ;;
      skill|skills|app|apps) has_managed=1 ;;
      features) has_features=1 ;;
      trust|untrust) has_trust=1 ;;
      config|configure) has_config=1 ;;
      login) has_login=1 ;;
      status) has_status=1 ;;
      logout) has_logout=1 ;;
      auth) has_auth=1 ;;
      oauth) has_oauth=1 ;;
      token) has_token=1 ;;
      refresh) has_refresh=1 ;;
      update) has_update=1 ;;
      upgrade) has_upgrade=1 ;;
    esac
  done

  if (( has_logout || has_auth || has_oauth || has_token || has_refresh )); then
    echo block
    return
  fi
  if (( has_login )); then
    if (( has_status && ! has_mcp && ! has_plugin && ! has_managed && ! has_features && ! has_config )); then
      echo second
      return
    fi
    echo block
    return
  fi
  if (( has_update || has_upgrade )); then
    if (( has_mcp || has_managed || has_features || has_config )); then
      echo reroute
      return
    fi
    echo block
    return
  fi
  if (( has_mcp || has_managed || has_features || has_trust || has_config )); then
    echo reroute
    return
  fi
  echo second
}

sync_projection() {
  refuse_symlink_home "primary" "$A_HOME"
  refuse_symlink_home "second" "$B_HOME"
  mkdir -p "$A_HOME" "$B_HOME"
  fail_on_unknown_entries "primary" "$A_HOME"
  fail_on_unknown_entries "second" "$B_HOME"
  fail_if_primary_has_no_environment
  local excludes=()
  for pattern in "${ACCOUNT_PATTERNS[@]}"; do
    excludes+=(--exclude="/$pattern")
  done
  rsync -a --delete "${excludes[@]}" "$A_HOME/" "$B_HOME/"
}

latest_second_session_id() {
  latest_session_id_for_home "$B_HOME"
}

latest_session_id_from_history() {
  local home="$1"
  local history="$home/history.jsonl"
  [[ -f "$history" ]] || {
    echo "second-codex could not find Codex history: $history" >&2
    return 67
  }
  local session_id
  session_id="$(sed -n 's/.*"session_id":"\([^"]*\)".*/\1/p' "$history" | tail -n 1)"
  [[ -n "$session_id" ]] || {
    echo "second-codex could not find a session_id in $history" >&2
    return 67
  }
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id in history: $session_id" >&2
    return 67
  fi
  printf '%s\n' "$session_id"
}

latest_session_id_for_home() {
  local home="$1"
  local cwd_filter="${2:-}"
  if [[ -z "$cwd_filter" ]]; then
    latest_session_id_from_history "$home"
    return
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    latest_session_id_from_history "$home"
    return
  fi
  python3 - "$home" "$cwd_filter" <<'PY'
import json
import sys
from pathlib import Path

home = Path(sys.argv[1])
cwd = sys.argv[2]
history = home / "history.jsonl"
sessions = home / "sessions"
if not history.is_file():
    print(f"second-codex could not find Codex history: {history}", file=sys.stderr)
    raise SystemExit(67)
if not sessions.is_dir():
    print(f"second-codex could not find Codex sessions directory: {sessions}", file=sys.stderr)
    raise SystemExit(67)

def session_cwd(session_id):
    matches = sorted(sessions.rglob(f"*{session_id}*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for path in matches[:3]:
        try:
            with path.open("r", encoding="utf-8", errors="replace") as fh:
                for idx, line in enumerate(fh):
                    if idx >= 25:
                        break
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if item.get("type") != "session_meta":
                        continue
                    payload = item.get("payload") or {}
                    return payload.get("cwd"), payload.get("id")
        except OSError:
            continue
    return None, None

seen = set()
try:
    lines = history.read_text(encoding="utf-8", errors="replace").splitlines()
except OSError as exc:
    print(f"second-codex could not read Codex history: {exc}", file=sys.stderr)
    raise SystemExit(67)

for line in reversed(lines[-500:]):
    try:
        session_id = json.loads(line).get("session_id")
    except json.JSONDecodeError:
        continue
    if not session_id or session_id in seen:
        continue
    seen.add(session_id)
    found_cwd, found_id = session_cwd(session_id)
    if found_cwd == cwd and found_id:
        print(found_id)
        raise SystemExit(0)

print(f"second-codex could not find a recent session for cwd: {cwd}", file=sys.stderr)
raise SystemExit(67)
PY
}

find_second_session_file() {
  local session_id="$1"
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi
  local sessions_dir="$B_HOME/sessions"
  [[ -d "$sessions_dir" ]] || {
    echo "second-codex could not find second account sessions directory: $sessions_dir" >&2
    return 67
  }
  local session_file
  session_file="$(find "$sessions_dir" -type f -name "*$session_id*.jsonl" -print | sort | tail -n 1 || true)"
  [[ -n "$session_file" ]] || {
    echo "second-codex could not find second account session file for: $session_id" >&2
    return 67
  }
  printf '%s\n' "$session_file"
}

append_primary_history_line() {
  local session_id="$1"
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi
  local second_history="$B_HOME/history.jsonl"
  local primary_history="$A_HOME/history.jsonl"
  [[ -f "$second_history" ]] || return 0

  local history_line
  history_line="$(grep -F "\"session_id\":\"$session_id\"" "$second_history" | tail -n 1 || true)"
  [[ -n "$history_line" ]] || return 0

  mkdir -p "$A_HOME"
  touch "$primary_history"
  chmod 600 "$primary_history" 2>/dev/null || true
  if ! grep -Fxq "$history_line" "$primary_history"; then
    printf '%s\n' "$history_line" >> "$primary_history"
  fi
}

handoff_session() {
  local requested="--last"
  local cwd_filter=""
  while (( $# > 0 )); do
    case "$1" in
      --cwd)
        if (( $# < 2 )); then
          echo "usage: second-codex handoff [SESSION_ID|--last] [--cwd PATH]" >&2
          return 64
        fi
        cwd_filter="$2"
        shift 2
        ;;
      --last)
        requested="--last"
        shift
        ;;
      -*)
        echo "usage: second-codex handoff [SESSION_ID|--last] [--cwd PATH]" >&2
        return 64
        ;;
      *)
        if [[ "$requested" != "--last" ]]; then
          echo "usage: second-codex handoff [SESSION_ID|--last] [--cwd PATH]" >&2
          return 64
        fi
        requested="$1"
        shift
        ;;
    esac
  done

  if [[ "$requested" != "--last" && -n "$cwd_filter" ]]; then
    echo "second-codex handoff cannot combine an explicit session id with --cwd" >&2
    return 64
  fi

  local session_id
  case "$requested" in
    ""|--last)
      session_id="$(latest_session_id_for_home "$B_HOME" "$cwd_filter")"
      ;;
    *)
      session_id="$requested"
      ;;
  esac
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi

  local second_session_file
  second_session_file="$(find_second_session_file "$session_id")"
  local rel_path="${second_session_file#"$B_HOME/sessions/"}"
  if [[ "$rel_path" == "$second_session_file" ]]; then
    echo "second-codex internal error: session path is outside second sessions directory" >&2
    return 70
  fi

  local primary_session_file="$A_HOME/sessions/$rel_path"
  if [[ -L "$A_HOME" || -L "$A_HOME/sessions" ]]; then
    echo "second-codex refused unsafe primary sessions path: $A_HOME/sessions" >&2
    return 73
  fi
  mkdir -p "$(dirname "$primary_session_file")"
  if [[ -e "$primary_session_file" ]]; then
    if ! cmp -s "$second_session_file" "$primary_session_file"; then
      echo "second-codex refused to overwrite different primary session file: $primary_session_file" >&2
      return 73
    fi
  else
    cp "$second_session_file" "$primary_session_file"
    chmod 600 "$primary_session_file" 2>/dev/null || true
  fi
  append_primary_history_line "$session_id"

  cat <<EOF
second-codex handoff
session_id=$session_id
copied_session=$primary_session_file
resume_primary_interactive=codex resume $session_id
resume_primary_exec=codex exec resume $session_id
EOF
}

session_hint() {
  local account="${1:-}"
  local cwd_filter="${2:-}"
  local home label resume handoff session_id
  case "$account" in
    primary)
      home="$A_HOME"
      label="codex"
      ;;
    second)
      home="$B_HOME"
      label="second-codex"
      ;;
    *)
      echo "usage: second-codex _session-hint primary|second [CWD]" >&2
      return 64
      ;;
  esac

  session_id="$(latest_session_id_for_home "$home" "$cwd_filter" 2>/dev/null || true)"
  [[ -n "$session_id" ]] || return 0
  resume="codex resume $session_id"
  handoff="second-codex handoff $session_id && $resume"
  if [[ "$account" == "primary" ]]; then
    printf '\n%s session_id=%s\nresume=%s\n' "$label" "$session_id" "$resume"
  else
    printf '\n%s session_id=%s\nhandoff_to_primary=%s\n' "$label" "$session_id" "$handoff"
  fi
}

ensure_shim() {
  if [[ -L "$BIN_DIR" ]]; then
    echo "second-codex refused to use symlinked shim directory: $BIN_DIR" >&2
    return 73
  fi
  mkdir -p "$BIN_DIR"
  chmod 700 "$BIN_DIR"
  local owner_uid
  owner_uid="$(stat -f '%u' "$BIN_DIR" 2>/dev/null || stat -c '%u' "$BIN_DIR")"
  if [[ "$owner_uid" != "$(id -u)" ]]; then
    echo "second-codex refused shim directory not owned by current user: $BIN_DIR" >&2
    return 73
  fi
  local mode
  mode="$(stat -f '%Lp' "$BIN_DIR" 2>/dev/null || stat -c '%a' "$BIN_DIR")"
  if [[ "$mode" != "700" ]]; then
    echo "second-codex refused shim directory with unsafe mode $mode: $BIN_DIR" >&2
    return 73
  fi
  if [[ -n "$REAL_CODEX" && "$REAL_CODEX" == "$BIN_DIR/codex" ]]; then
    echo "second-codex refused recursive codex shim resolution: $REAL_CODEX" >&2
    return 69
  fi
  local tmp_shim
  tmp_shim="$(umask 077; mktemp "$BIN_DIR/codex.XXXXXX")"
  cat > "$tmp_shim" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exec "${SECOND_CODEX_SWITCH_WRAPPER:?missing SECOND_CODEX_SWITCH_WRAPPER}" "$@"
EOF
  chmod 700 "$tmp_shim"
  mv "$tmp_shim" "$BIN_DIR/codex"
}

auth_status() {
  local auth_file="$1/auth.json"
  [[ -f "$auth_file" ]] || { echo "not logged in"; return 0; }
  if [[ "${SECOND_CODEX_DOCTOR_SHOW_EMAIL:-0}" != "1" ]]; then
    echo "logged in"
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "logged in (python3 missing)"
    return 0
  fi
  python3 - "$auth_file" <<'PY' 2>/dev/null || echo "unknown"
import base64, json, sys
from pathlib import Path
try:
    data = json.loads(Path(sys.argv[1]).read_text())
    token = (data.get("tokens") or {}).get("id_token") or ""
    if token.count(".") < 2:
        print("unknown")
        raise SystemExit
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode(payload))
    print(claims.get("email") or "unknown")
except Exception:
    print("unknown")
PY
}

doctor() {
  local failed=0
  echo "second-codex doctor"
  echo "primary_home=$A_HOME"
  echo "second_home=$B_HOME"
  echo "shim_dir=$BIN_DIR"
  echo "primary_auth=$(auth_status "$A_HOME")"
  echo "second_auth=$(auth_status "$B_HOME")"

  local unknown
  unknown="$(unknown_entries "$A_HOME")"
  if [[ -n "$unknown" ]]; then
    echo "FAIL unknown primary CODEX_HOME entries:"
    printf '%s\n' "$unknown" | sed 's/^/  - /'
    failed=1
  else
    echo "PASS no unknown primary CODEX_HOME entries"
  fi

  unknown="$(unknown_entries "$B_HOME")"
  if [[ -n "$unknown" ]]; then
    echo "FAIL unknown second CODEX_HOME entries:"
    printf '%s\n' "$unknown" | sed 's/^/  - /'
    failed=1
  else
    echo "PASS no unknown second CODEX_HOME entries"
  fi

  if [[ -L "$B_HOME/memories" && "$(readlink "$B_HOME/memories")" == "$A_HOME/memories" ]]; then
    echo "PASS memories symlink to primary"
  else
    echo "FAIL memories is not a symlink to primary"
    failed=1
  fi

  if [[ -L "$B_HOME/memories_extensions" && "$(readlink "$B_HOME/memories_extensions")" == "$A_HOME/memories_extensions" ]]; then
    echo "PASS memories_extensions symlink to primary"
  else
    echo "FAIL memories_extensions is not a symlink to primary"
    failed=1
  fi

  ensure_shim || failed=1
  if [[ -x "$BIN_DIR/codex" && ! -L "$BIN_DIR" ]]; then
    echo "PASS shim exists in owned non-symlink directory"
  else
    echo "FAIL shim missing or unsafe"
    failed=1
  fi

  local block_out=""
  block_out="$(mktemp "${TMPDIR:-/tmp}/second-codex-doctor.XXXXXX")"
  local blocked_ok=1
  doctor_expect_block() {
    : > "$block_out"
    if "$WRAPPER_PATH" "$@" >"$block_out" 2>&1; then
      blocked_ok=0
      return
    fi
    grep -q "refused this account/auth command" "$block_out" || blocked_ok=0
  }
  doctor_expect_block login
  doctor_expect_block logout
  doctor_expect_block update
  doctor_expect_block plugin login
  doctor_expect_block mcp oauth
  doctor_expect_block mcp -- oauth
  if (( blocked_ok )); then
    echo "PASS account/auth command blocked"
  else
    echo "FAIL account/auth command was not blocked consistently"
    failed=1
  fi
  rm -f "$block_out"
  block_out=""

  return "$failed"
}

main() {
  case "${1:-}" in
    _session-hint)
      shift
      session_hint "$@"
      return
      ;;
    handoff)
      shift
      handoff_session "$@"
      return
      ;;
    session-id)
      shift
      case "${1:-}" in
        --primary)
          latest_session_id_for_home "$A_HOME" "${2:-}"
          ;;
        --second|"")
          latest_session_id_for_home "$B_HOME" "${2:-}"
          ;;
        *)
          echo "usage: second-codex session-id [--primary|--second] [CWD]" >&2
          return 64
          ;;
      esac
      return
      ;;
  esac

  load_manifest
  refuse_symlink_home "primary" "$A_HOME"
  refuse_symlink_home "second" "$B_HOME"
  ensure_shared_paths
  ensure_shim

  if [[ "${1:-}" == "doctor" ]]; then
    doctor
    return
  fi

  local classification
  classification="$(classify_command "$@")"

  if [[ "$classification" == "block" ]]; then
    block_reason
    return 64
  fi

  sync_projection
  case "$classification" in
    reroute)
      reroute_notice
      if [[ -z "$REAL_CODEX" || ! -x "$REAL_CODEX" ]]; then
        echo "second-codex could not find executable codex binary in PATH" >&2
        return 69
      fi
      CODEX_HOME="$A_HOME" "$REAL_CODEX" "$@"
      sync_projection
      ;;
    second)
      if [[ -z "$REAL_CODEX" || ! -x "$REAL_CODEX" ]]; then
        echo "second-codex could not find executable codex binary in PATH" >&2
        return 69
      fi
      SECOND_CODEX_SWITCH_WRAPPER="$WRAPPER_PATH" \
        SECOND_CODEX_SWITCH_REAL_CODEX="$REAL_CODEX" \
        PATH="$BIN_DIR:$PATH" \
        CODEX_HOME="$B_HOME" \
        "$REAL_CODEX" "$@"
      ;;
    *)
      echo "second-codex internal error: unknown command classification '$classification'" >&2
      return 70
      ;;
  esac
}

main "$@"

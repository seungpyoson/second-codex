#!/usr/bin/env bash
set -euo pipefail

ROOT="${SECOND_CODEX_SWITCH_ROOT:-$HOME/.codex-account-switch}"
A_HOME="${CODEX_A_HOME:-$HOME/.codex}"
B_HOME="${SECOND_CODEX_HOME:-$HOME/.codex-second}"
BIN_DIR="${SECOND_CODEX_SHIM_DIR:-${TMPDIR:-/tmp}/second-codex-shim-$(id -u)}"
A_HOME="${A_HOME%/}"
B_HOME="${B_HOME%/}"
BIN_DIR="${BIN_DIR%/}"
WRAPPER_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REAL_CODEX="${SECOND_CODEX_SWITCH_REAL_CODEX:-$(command -v codex || true)}"

ACCOUNT_PATTERNS=()
ENVIRONMENT_PATTERNS=()

block_reason() {
  cat >&2 <<'EOF'
second-codex refused this account/auth command.
Run account/auth changes explicitly from the intended Codex account.
EOF
}

option_takes_value() {
  case "$1" in
    -c|--config|-m|--model|-p|--profile|-s|--sandbox|-C|--cd|-a|--ask-for-approval|--remote|--remote-auth-token-env|--add-dir|--local-provider|--download-url|--enable|--disable|-i|--image|--output-schema|--color|-o|--output-last-message)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

option_takes_no_value() {
  case "$1" in
    --oss|--dangerously-bypass-approvals-and-sandbox|--search|--no-alt-screen|--skip-git-repo-check|--ephemeral|--ignore-user-config|--ignore-rules|--json|-h|--help|-V|--version)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

resume_option_takes_no_value() {
  case "$1" in
    --last|--all|--include-non-interactive)
      return 0
      ;;
    *)
      option_takes_no_value "$1"
      ;;
  esac
}

resume_option_suppresses_session_arg() {
  case "$1" in
    --last|--last=*|-h|--help|--help=*|-V|--version|--version=*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

find_manifest() {
  local script_dir
  script_dir="$(cd "$(dirname "$WRAPPER_PATH")" && pwd)"
  local candidates=(
    "${SECOND_CODEX_MANIFEST:-}"
    "$ROOT/ownership-manifest.txt"
    "$script_dir/ownership-manifest.txt"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

load_manifest() {
  local manifest section line
  if ! manifest="$(find_manifest)"; then
    echo "second-codex missing ownership manifest" >&2
    return 66
  fi

  ACCOUNT_PATTERNS=()
  ENVIRONMENT_PATTERNS=()
  section=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    case "$line" in
      '['*']')
        section="${line#[}"
        section="${section%]}"
        ;;
      *)
        case "$section" in
          account-runtime|shared-by-reference)
            ACCOUNT_PATTERNS+=("$line")
            ;;
          primary-owned-environment)
            ENVIRONMENT_PATTERNS+=("$line")
            ;;
        esac
        ;;
    esac
  done < "$manifest"

  if (( ${#ACCOUNT_PATTERNS[@]} == 0 || ${#ENVIRONMENT_PATTERNS[@]} == 0 )); then
    echo "second-codex ownership manifest did not define required pattern groups: $manifest" >&2
    return 66
  fi
}

matches_any_pattern() {
  local value="$1"
  shift
  local pattern normalized
  for pattern in "$@"; do
    normalized="${pattern%/}"
    [[ "$value" == $pattern ]] && return 0
    [[ "$value" == $normalized ]] && return 0
  done
  return 1
}

unknown_entries() {
  local home="$1"
  [[ -d "$home" ]] || return 0
  local path name
  while IFS= read -r -d '' path; do
    name="${path##*/}"
    matches_any_pattern "$name" "${ACCOUNT_PATTERNS[@]}" && continue
    matches_any_pattern "$name" "${ENVIRONMENT_PATTERNS[@]}" && continue
    printf '%s\n' "$name"
  done < <(find "$home" -mindepth 1 -maxdepth 1 -print0)
}

fail_on_unknown_entries() {
  local label="$1"
  local home="$2"
  local unknown
  unknown="$(unknown_entries "$home")"
  [[ -z "$unknown" ]] && return 0
  {
    echo "second-codex refused to sync because $label CODEX_HOME has unknown top-level entries:"
    printf '%s\n' "$unknown" | sed 's/^/  - /'
    echo "Classify these in ownership-manifest.txt before syncing."
  } >&2
  return 65
}

ensure_shared_path() {
  local name="$1"
  local target="$A_HOME/$name"
  local link="$B_HOME/$name"

  if [[ -e "$target" && ! -d "$target" ]]; then
    echo "second-codex refused shared path because primary $target is not a directory." >&2
    return 73
  fi
  mkdir -p "$target" "$B_HOME"
  if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
    return 0
  fi
  if [[ -e "$link" || -L "$link" ]]; then
    echo "second-codex refused to replace existing $link; move it aside, then rerun." >&2
    return 73
  fi
  ln -s "$target" "$link"
}

ensure_shared_paths() {
  ensure_shared_path memories
  ensure_shared_path memories_extensions
}

reroute_notice() {
  printf 'second-codex: rerouting environment/config change to primary CODEX_HOME: %s\n' "$A_HOME" >&2
}

is_valid_session_id() {
  [[ "$1" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]
}

refuse_symlink_home() {
  local label="$1"
  local home="$2"
  local noun="${3:-CODEX_HOME}"
  local path="$home"
  local current="" part target
  local -a parts
  [[ "$path" == /* ]] || path="$PWD/$path"
  path="${path%/}"
  IFS=/ read -r -a parts <<< "${path#/}"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    current="$current/$part"
    if [[ -L "$current" ]]; then
      target="$(readlink "$current")"
      case "$current:$target" in
        /var:private/var|/var:/private/var|/tmp:private/tmp|/tmp:/private/tmp|/etc:private/etc|/etc:/private/etc)
          continue
          ;;
      esac
      echo "second-codex refused symlinked $label $noun: $home" >&2
      return 73
    fi
  done
}

refuse_same_homes() {
  if [[ "$A_HOME" == "$B_HOME" ]]; then
    echo "second-codex refused to run because primary and second CODEX_HOME are the same: $A_HOME" >&2
    return 64
  fi
}

guard_home_roots() {
  refuse_symlink_home "primary" "$A_HOME"
  refuse_symlink_home "second" "$B_HOME"
  refuse_same_homes
}

guard_manifest_homes() {
  load_manifest
  guard_home_roots
  fail_on_unknown_entries "primary" "$A_HOME"
  fail_on_unknown_entries "second" "$B_HOME"
}

home_has_environment_sentinel() {
  local home="$1"
  local path name
  [[ -d "$home" ]] || return 1
  while IFS= read -r -d '' path; do
    name="${path##*/}"
    matches_any_pattern "$name" "${ENVIRONMENT_PATTERNS[@]}" && return 0
  done < <(find "$home" -mindepth 1 -maxdepth 1 -print0)
  return 1
}

fail_if_primary_has_no_environment() {
  if home_has_environment_sentinel "$A_HOME"; then
    return 0
  fi
  cat >&2 <<EOF
second-codex refused destructive projection because primary CODEX_HOME has no environment entries: $A_HOME
Set up primary Codex first, or check CODEX_A_HOME.
EOF
  return 65
}

token_is_auth_mutation() {
  case "$1" in
    login|logout|auth|oauth|token|refresh|signout|sign-out|signin|sign-in|deauth|reauth|reconnect|authenticate|authorize|session-create|account-switch|verify-auth)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

option_is_auth_mutation() {
  case "$1" in
    --login|--login=*|--logout|--logout=*|\
    --auth|--auth=*|--oauth|--oauth=*|--oauth-redirect|--oauth-redirect=*|\
    --auth-token|--auth-token=*|--token|--token=*|--refresh-token|--refresh-token=*|\
    --signin|--signin=*|--sign-in|--sign-in=*|\
    --signout|--signout=*|--sign-out|--sign-out=*|\
    --deauth|--deauth=*|--reauth|--reauth=*|\
    --reconnect|--reconnect=*|--verify-auth|--verify-auth=*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

token_is_setup_command() {
  case "$1" in
    mcp|plugin|plugins|skill|skills|app|apps|features|trust|untrust|config|configure)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

token_is_runtime_mutation() {
  case "$1" in
    update|upgrade)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

classify_known_command() {
  local command="$1"
  shift || true
  local has_status=0 has_setup=0 token

  case "$command" in
    exec|e|resume|chat)
      local after_separator=0
      for token in "$@"; do
        if (( after_separator )); then
          continue
        fi
        if [[ "$token" == "--" ]]; then
          after_separator=1
          continue
        fi
        option_is_auth_mutation "$token" && { echo block; return; }
      done
      echo second
      return
      ;;
    login)
      for token in "$@"; do
        option_is_auth_mutation "$token" && { echo block; return; }
        [[ "$token" == status ]] && has_status=1
        token_is_setup_command "$token" && has_setup=1
      done
      if (( has_status && ! has_setup )); then
        echo second
      else
        echo block
      fi
      return
      ;;
    update|upgrade)
      echo block
      return
      ;;
  esac

  if token_is_auth_mutation "$command"; then
    echo block
    return
  fi

  if token_is_setup_command "$command"; then
    local subcommand="" marketplace_subcommand="" after_separator=0
    local setup_args=("$@")
    local j=0
    while (( j < ${#setup_args[@]} )); do
      token="${setup_args[$j]}"
      if [[ "$token" == "--" ]]; then
        if [[ -z "$subcommand" ]]; then
          after_separator=0
        else
          after_separator=1
        fi
        j=$((j + 1))
        continue
      fi
      if (( after_separator )); then
        j=$((j + 1))
        continue
      fi
      option_is_auth_mutation "$token" && { echo block; return; }
      if [[ "$token" == --*=* ]]; then
        j=$((j + 1))
        continue
      fi
      if [[ "$token" == -* ]]; then
        if option_takes_value "$token" && (( j + 1 < ${#setup_args[@]} )); then
          j=$((j + 2))
        else
          j=$((j + 1))
        fi
        continue
      fi

      if [[ -z "$subcommand" ]]; then
        subcommand="$token"
        token_is_auth_mutation "$token" && { echo block; return; }
        j=$((j + 1))
        continue
      fi

      case "$command:$subcommand" in
        plugin:marketplace|plugins:marketplace|skill:marketplace|skills:marketplace|app:marketplace|apps:marketplace)
          if [[ -z "$marketplace_subcommand" ]]; then
            marketplace_subcommand="$token"
            token_is_auth_mutation "$token" && { echo block; return; }
          fi
          ;;
      esac
      j=$((j + 1))
    done
    echo reroute
    return
  fi

  echo second
}

classify_command() {
  local args=("$@")
  local i=0 saw_ambiguous_option=0 scan_after_ambiguous_option=0 arg
  for arg in "${args[@]}"; do
    [[ "$arg" == "--" ]] && break
    option_is_auth_mutation "$arg" && { echo block; return; }
  done
  while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    case "$arg" in
      --)
        echo second
        return
        ;;
      --*=*)
        option_is_auth_mutation "$arg" && { echo block; return; }
        i=$((i + 1))
        ;;
      -*)
        option_is_auth_mutation "$arg" && { echo block; return; }
        if option_takes_no_value "$arg"; then
          i=$((i + 1))
        elif option_takes_value "$arg" && (( i + 1 < ${#args[@]} )); then
          i=$((i + 2))
        else
          saw_ambiguous_option=1
          scan_after_ambiguous_option=1
          i=$((i + 1))
        fi
        ;;
      *)
        if (( saw_ambiguous_option )); then
          saw_ambiguous_option=0
          i=$((i + 1))
          continue
        fi
        if token_is_auth_mutation "$arg" || token_is_setup_command "$arg" || token_is_runtime_mutation "$arg" || [[ "$arg" == exec || "$arg" == e || "$arg" == resume || "$arg" == chat ]]; then
          classify_known_command "$arg" "${args[@]:$((i + 1))}"
          return
        fi
        if (( scan_after_ambiguous_option )); then
          i=$((i + 1))
          continue
        fi
        echo second
        return
        ;;
    esac
  done
  echo second
}

sync_projection() {
  guard_home_roots
  mkdir -p "$A_HOME" "$B_HOME"
  fail_on_unknown_entries "primary" "$A_HOME"
  fail_on_unknown_entries "second" "$B_HOME"
  fail_if_primary_has_no_environment
  local excludes=()
  local pattern
  for pattern in "${ACCOUNT_PATTERNS[@]}"; do
    excludes+=(--exclude="/$pattern")
  done
  rsync -a --delete "${excludes[@]}" "$A_HOME/" "$B_HOME/"
}

require_runtime_dependencies() {
  local classification="$1"
  case "$classification" in
    reroute|second)
      ;;
    *)
      return 0
      ;;
  esac

  if [[ "${SECOND_CODEX_TEST_DISABLE_RSYNC:-0}" == "1" ]] || ! command -v rsync >/dev/null 2>&1; then
    echo "second-codex requires rsync for CODEX_HOME projection, but rsync was not found in PATH" >&2
    return 69
  fi
  if [[ -z "$REAL_CODEX" || ! -x "$REAL_CODEX" ]]; then
    echo "second-codex could not find executable codex binary in PATH" >&2
    return 69
  fi
}

infer_account_slot() {
  if [[ -n "${CODEX_ACCOUNT_SLOT:-}" ]]; then
    printf '%s\n' "$CODEX_ACCOUNT_SLOT"
    return
  fi
  case "${CODEX_HOME:-}" in
    "$B_HOME")
      printf 'second\n'
      ;;
    "$A_HOME")
      printf 'primary\n'
      ;;
    *)
      printf 'unknown\n'
      ;;
  esac
}

home_for_account_slot() {
  case "$1" in
    primary)
      printf '%s\n' "$A_HOME"
      ;;
    second)
      printf '%s\n' "$B_HOME"
      ;;
    *)
      printf '%s\n' "${CODEX_HOME:-}"
      ;;
  esac
}

account_status() {
  local slot
  slot="$(infer_account_slot)"
  local home
  home="${CODEX_HOME:-$(home_for_account_slot "$slot")}"
  printf 'account_slot=%s\n' "$slot"
  printf 'codex_home=%s\n' "${home:-unset}"
}

usage_status() {
  local slot
  if (( $# > 1 )); then
    echo "usage: second-codex usage [--primary|--second]" >&2
    return 64
  fi
  case "${1:-}" in
    --primary)
      slot="primary"
      ;;
    --second|"")
      if [[ "${1:-}" == "--second" ]]; then
        slot="second"
      else
        slot="$(infer_account_slot)"
        [[ "$slot" == "unknown" ]] && slot="second"
      fi
      ;;
    *)
      echo "usage: second-codex usage [--primary|--second]" >&2
      return 64
      ;;
  esac

  local home session_id session_file
  guard_home_roots
  home="$(home_for_account_slot "$slot")"
  [[ -n "$home" ]] || {
    echo "second-codex usage could not infer CODEX_HOME" >&2
    return 67
  }
  session_id="$(latest_session_id_for_home "$home")" || return $?
  session_file="$(find_session_file_for_home "$home" "$session_id" "$slot account")" || return $?

  printf 'account_slot=%s\n' "$slot"
  printf 'codex_home=%s\n' "$home"
  printf 'session_id=%s\n' "$session_id"
  if [[ "${SECOND_CODEX_TEST_DISABLE_PYTHON3:-0}" == "1" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "second-codex usage requires python3 to read Codex usage snapshots" >&2
    return 67
  fi
  python3 - "$session_file" <<'PY'
import json
import sys
from pathlib import Path

snapshot = None
with Path(sys.argv[1]).open("r", encoding="utf-8", errors="replace") as fh:
    for line in fh:
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        payload = item.get("payload") or {}
        if item.get("type") == "event_msg" and payload.get("type") == "token_count":
            snapshot = payload

if snapshot is None:
    print("usage_snapshot=missing")
    raise SystemExit(0)

info = snapshot.get("info") or {}
total = info.get("total_token_usage") or {}
last = info.get("last_token_usage") or {}
limits = snapshot.get("rate_limits") or {}

def emit(name, value):
    if value is not None:
        print(f"{name}={value}")

emit("total_tokens", total.get("total_tokens"))
emit("input_tokens", total.get("input_tokens"))
emit("cached_input_tokens", total.get("cached_input_tokens"))
emit("output_tokens", total.get("output_tokens"))
emit("reasoning_output_tokens", total.get("reasoning_output_tokens"))
emit("last_total_tokens", last.get("total_tokens"))
emit("context_window", info.get("model_context_window"))
for label in ("primary", "secondary"):
    limit = limits.get(label) or {}
    emit(f"{label}_used_percent", limit.get("used_percent"))
    emit(f"{label}_window_minutes", limit.get("window_minutes"))
    emit(f"{label}_resets_at", limit.get("resets_at"))
emit("plan_type", limits.get("plan_type"))
emit("rate_limit_reached_type", limits.get("rate_limit_reached_type"))
PY
}

latest_second_session_id() {
  latest_session_id_for_home "$B_HOME"
}

latest_session_id_from_history() {
  local home="$1"
  local history="$home/history.jsonl"
  [[ -f "$history" ]] || {
    echo "second-codex could not find Codex history: $history" >&2
    return 67
  }
  local session_id
  session_id="$(tail -n 500 "$history" | sed -n 's/.*"session_id":[[:space:]]*"\([^"]*\)".*/\1/p' | tail -n 1)"
  [[ -n "$session_id" ]] || {
    echo "second-codex could not find a session_id in $history" >&2
    return 67
  }
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id in history: $session_id" >&2
    return 67
  fi
  printf '%s\n' "$session_id"
}

latest_session_id_for_home() {
  local home="$1"
  local cwd_filter="${2:-}"
  if [[ -z "$cwd_filter" ]]; then
    latest_session_id_from_history "$home"
    return
  fi
  if [[ "${SECOND_CODEX_TEST_DISABLE_PYTHON3:-0}" == "1" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "second-codex: python3 not found; cannot filter sessions by cwd. Omit --cwd or install python3." >&2
    return 67
  fi
  python3 - "$home" "$cwd_filter" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

home = Path(sys.argv[1])
# Resolve cwd to its physical path so cwd matching is symlink-safe.
# Native Codex captures cwd via POSIX getcwd() which returns the physical
# path on macOS — a session opened in /tmp/foo is recorded as
# /private/tmp/foo. If a caller passes the symlinked path here, the
# direct-equality compare at line ~743 would never match. realpath both
# sides so the comparison is layout-agnostic. (Gemini-CA review of PR #7.)
cwd_input = sys.argv[2]
try:
    cwd = os.path.realpath(cwd_input)
except OSError:
    cwd = cwd_input
history = home / "history.jsonl"
sessions = home / "sessions"
# UUID-shape guard. session_id is read from history.jsonl and substituted
# into the glob below; a metacharacter (`*`, `?`, `[`) would expand the
# glob unexpectedly. Codex always writes UUIDs here, but defense-in-depth:
# the bash wrapper validates UUIDs everywhere else (is_valid_session_id),
# this is the one entry point that crosses into Python without that guard.
# (Greptile P2 review of PR #7.)
_SESSION_ID_RE = re.compile(r"\A[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\Z")
if not history.is_file():
    print(f"second-codex could not find Codex history: {history}", file=sys.stderr)
    raise SystemExit(67)
if not sessions.is_dir():
    print(f"second-codex could not find Codex sessions directory: {sessions}", file=sys.stderr)
    raise SystemExit(67)

def tail_lines(path, max_lines=500, block_size=8192):
    with path.open("rb") as fh:
        fh.seek(0, 2)
        position = fh.tell()
        blocks = []
        line_count = 0
        while position > 0 and line_count <= max_lines:
            read_size = min(block_size, position)
            position -= read_size
            fh.seek(position)
            block = fh.read(read_size)
            blocks.append(block)
            line_count += block.count(b"\n")
        data = b"".join(reversed(blocks))
    return data.decode("utf-8", errors="replace").splitlines()[-max_lines:]

seen = set()
try:
    lines = tail_lines(history)
except OSError as exc:
    print(f"second-codex could not read Codex history: {exc}", file=sys.stderr)
    raise SystemExit(67)

recent_rank = {}
for line in reversed(lines):
    try:
        session_id = json.loads(line).get("session_id")
    except json.JSONDecodeError:
        continue
    if not session_id or session_id in seen:
        continue
    # Drop anything that isn't a Codex UUID — protects the glob below
    # from metacharacter expansion. A non-UUID entry in history.jsonl
    # would never match a real rollout file anyway.
    if not isinstance(session_id, str) or not _SESSION_ID_RE.match(session_id):
        continue
    seen.add(session_id)
    recent_rank[session_id] = len(recent_rank)

best = None

# Iterate recent sessions in recency order (most recent first) and use a
# *targeted* glob for each session id rather than `sessions.rglob("*.jsonl")`.
# The pre-#6 implementation walked the entire `sessions/` tree on every
# shell command — O(total sessions) per hint generation, noticeable lag
# once sessions accumulate. The targeted approach is O(history-depth)
# bounded by `recent_rank` (typically ≤500) regardless of total corpus
# size, and stops at the first cwd match.
#
# Codex rollout layout: `sessions/YYYY/MM/DD/rollout-<TS>-<UUID>.jsonl`.
# A `*/*/*/rollout-*-{session_id}.jsonl` glob is bounded to four path
# segments and matches at most a handful of files in practice (typically
# one).
try:
    for session_id in sorted(recent_rank, key=recent_rank.get):
        for path in sessions.glob(f"*/*/*/rollout-*-{session_id}.jsonl"):
            try:
                with path.open("r", encoding="utf-8", errors="replace") as fh:
                    for idx, line in enumerate(fh):
                        if idx >= 25:
                            break
                        try:
                            item = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        if item.get("type") != "session_meta":
                            continue
                        payload = item.get("payload") or {}
                        record_cwd = payload.get("cwd")
                        # Symlink-safe cwd compare: the rollout's cwd
                        # *should* already be physical (Codex uses
                        # getcwd()), but realpath defensively in case a
                        # converted/migrated rollout carries a symlinked
                        # path. realpath of an already-physical path is a
                        # no-op.
                        try:
                            record_cwd_real = os.path.realpath(record_cwd) if record_cwd else None
                        except OSError:
                            record_cwd_real = record_cwd
                        if record_cwd_real != cwd or payload.get("id") != session_id:
                            break
                        best = session_id
                        break
            except OSError:
                continue
            if best:
                break
        if best:
            break
except OSError as exc:
    print(f"second-codex could not scan Codex sessions: {exc}", file=sys.stderr)
    raise SystemExit(67)

if best:
    print(best)
    raise SystemExit(0)

print(f"second-codex could not find a recent session for cwd: {cwd}", file=sys.stderr)
raise SystemExit(67)
PY
}

find_second_session_file() {
  find_session_file_for_home "$B_HOME" "$1" "second account"
}

find_session_file_for_home() {
  local home="$1"
  local session_id="$2"
  local label="$3"
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi
  local sessions_dir="$home/sessions"
  [[ -d "$sessions_dir" ]] || {
    echo "second-codex could not find $label sessions directory: $sessions_dir" >&2
    return 67
  }
  local session_file=""
  local candidate
  while IFS= read -r -d '' candidate; do
    if session_file_contains_id "$candidate" "$session_id"; then
      session_file="$candidate"
    fi
  done < <(find "$sessions_dir" -type f -name "*$session_id*.jsonl" -print0)
  [[ -n "$session_file" ]] || {
    echo "second-codex could not find $label session file for: $session_id" >&2
    return 67
  }
  printf '%s\n' "$session_file"
}

session_file_contains_id() {
  local session_file="$1"
  local session_id="$2"
  local line
  if [[ "${SECOND_CODEX_TEST_DISABLE_PYTHON3:-0}" != "1" ]] && command -v python3 >/dev/null 2>&1; then
    python3 - "$session_file" "$session_id" <<'PY' 2>/dev/null && return 0
import json, sys
from pathlib import Path

lines = []
with Path(sys.argv[1]).open("r", encoding="utf-8", errors="replace") as fh:
    for idx, line in enumerate(fh):
        if idx >= 25:
            break
        lines.append(line)
text = "".join(lines).lstrip()
session_id = sys.argv[2]
decoder = json.JSONDecoder()
while text:
    try:
        obj, end = decoder.raw_decode(text)
    except json.JSONDecodeError:
        break
    if obj.get("type") == "session_meta" and (obj.get("payload") or {}).get("id") == session_id:
        raise SystemExit(0)
    text = text[end:].lstrip()
raise SystemExit(1)
PY
  fi
  while IFS= read -r line; do
    case "$line" in
      *'"type"'*'"session_meta"'*|*'"session_meta"'*'"type"'*)
        printf '%s\n' "$line" | grep -Eq "\"id\"[[:space:]]*:[[:space:]]*\"$session_id\"" && return 0
        ;;
    esac
  done < <(sed -n '1,25p' "$session_file")
  return 1
}

session_file_exists_for_home() {
  local home="$1"
  local session_id="$2"
  [[ -d "$home/sessions" ]] || return 1
  local candidate
  while IFS= read -r -d '' candidate; do
    session_file_contains_id "$candidate" "$session_id" && return 0
  done < <(find "$home/sessions" -type f -name "*$session_id*.jsonl" -print0)
  return 1
}

refuse_symlink_components() {
  local root="$1"
  local rel_dir="$2"
  local label="$3"
  local current="$root"
  local part remaining="$rel_dir"

  [[ -z "$rel_dir" || "$rel_dir" == "." ]] && return 0

  while [[ -n "$remaining" ]]; do
    if [[ "$remaining" == */* ]]; then
      part="${remaining%%/*}"
      remaining="${remaining#*/}"
    else
      part="$remaining"
      remaining=""
    fi
    [[ -z "$part" || "$part" == "." ]] && continue
    if [[ "$part" == ".." ]]; then
      echo "second-codex refused unsafe $label sessions path: $root/$rel_dir" >&2
      return 73
    fi
    current="$current/$part"
    if [[ -L "$current" ]]; then
      echo "second-codex refused unsafe $label sessions path: $current" >&2
      return 73
    fi
  done
}

copy_session_between_homes() {
  local source_home="$1"
  local target_home="$2"
  local session_id="$3"
  local source_label="$4"
  local target_label="$5"
  local source_session_file
  source_session_file="$(find_session_file_for_home "$source_home" "$session_id" "$source_label")" || return $?
  local rel_path="${source_session_file#"$source_home/sessions/"}"
  if [[ "$rel_path" == "$source_session_file" ]]; then
    echo "second-codex internal error: session path is outside $source_label sessions directory" >&2
    return 70
  fi

  if [[ -L "$target_home" || -L "$target_home/sessions" ]]; then
    echo "second-codex refused unsafe $target_label sessions path: $target_home/sessions" >&2
    return 73
  fi
  local target_session_file="$target_home/sessions/$rel_path"
  local rel_dir
  rel_dir="$(dirname "$rel_path")"
  refuse_symlink_components "$target_home/sessions" "$rel_dir" "$target_label" || return $?
  mkdir -p "$(dirname "$target_session_file")"
  refuse_symlink_components "$target_home/sessions" "$rel_dir" "$target_label" || return $?
  if [[ -L "$target_session_file" ]]; then
    echo "second-codex refused to overwrite symlink: $target_session_file" >&2
    return 73
  fi
  if [[ -e "$target_session_file" || -L "$target_session_file" ]]; then
    if ! cmp -s "$source_session_file" "$target_session_file"; then
      echo "second-codex refused to overwrite different $target_label session file: $target_session_file" >&2
      return 73
    fi
    chmod 600 "$target_session_file"
  else
    (umask 077; cp "$source_session_file" "$target_session_file")
    chmod 600 "$target_session_file"
  fi
  printf '%s\n' "$target_session_file"
}

refuse_symlinked_history_target() {
  local target_home="$1"
  local target_label="$2"
  local target_history="$target_home/history.jsonl"
  if [[ -L "$target_history" ]]; then
    echo "second-codex refused to append through symlinked $target_label history: $target_history" >&2
    return 73
  fi
}

append_history_line_between_homes() {
  local source_home="$1"
  local target_home="$2"
  local session_id="$3"
  local target_label="${4:-target}"
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi
  local source_history="$source_home/history.jsonl"
  local target_history="$target_home/history.jsonl"
  [[ -f "$source_history" ]] || return 0
  refuse_symlinked_history_target "$target_home" "$target_label" || return $?

  local history_line
  history_line="$(grep -E "\"session_id\"[[:space:]]*:[[:space:]]*\"$session_id\"" "$source_history" | tail -n 1 || true)"
  [[ -n "$history_line" ]] || return 0

  mkdir -p "$target_home"
  touch "$target_history"
  chmod 600 "$target_history" 2>/dev/null || true
  if ! grep -Fxq "$history_line" "$target_history"; then
    printf '%s\n' "$history_line" >> "$target_history"
  fi
}

append_primary_history_line() {
  local session_id="$1"
  append_history_line_between_homes "$B_HOME" "$A_HOME" "$session_id" "primary"
}

import_primary_session_to_second() {
  local session_id="$1"
  local copied_session
  refuse_symlinked_history_target "$B_HOME" "second account" || return $?
  copied_session="$(copy_session_between_homes "$A_HOME" "$B_HOME" "$session_id" "primary Codex" "second account")"
  append_history_line_between_homes "$A_HOME" "$B_HOME" "$session_id" "second account"
  cat >&2 <<EOF
second-codex: imported primary Codex session into second account runtime: $session_id
second-codex: copied_session=$copied_session
EOF
}

find_session_id_after_resume_command() {
  local args=("$@")
  local i=0 saw_ambiguous_option=0 arg
  while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    case "$arg" in
      --)
        i=$((i + 1))
        if (( i < ${#args[@]} )) && is_valid_session_id "${args[$i]}"; then
          printf '%s\n' "${args[$i]}"
          return 0
        fi
        return 1
        ;;
      --*=*)
        resume_option_suppresses_session_arg "$arg" && return 1
        i=$((i + 1))
        ;;
      -*)
        resume_option_suppresses_session_arg "$arg" && return 1
        if resume_option_takes_no_value "$arg"; then
          i=$((i + 1))
        elif option_takes_value "$arg" && (( i + 1 < ${#args[@]} )); then
          i=$((i + 2))
        else
          saw_ambiguous_option=1
          i=$((i + 1))
        fi
        ;;
      *)
        if (( saw_ambiguous_option )); then
          saw_ambiguous_option=0
          i=$((i + 1))
          continue
        fi
        if is_valid_session_id "$arg"; then
          printf '%s\n' "$arg"
          return 0
        fi
        return 1
        ;;
    esac
  done
  return 1
}

find_resume_session_arg() {
  local args=("$@")
  local i=0 saw_ambiguous_option=0 arg
  while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    case "$arg" in
      --)
        return 1
        ;;
      --*=*)
        i=$((i + 1))
        ;;
      -*)
        if option_takes_no_value "$arg"; then
          i=$((i + 1))
        elif option_takes_value "$arg" && (( i + 1 < ${#args[@]} )); then
          i=$((i + 2))
        else
          saw_ambiguous_option=1
          i=$((i + 1))
        fi
        ;;
      exec|e)
        i=$((i + 1))
        saw_ambiguous_option=0
        while (( i < ${#args[@]} )); do
          arg="${args[$i]}"
          case "$arg" in
            --)
              return 1
              ;;
            --*=*)
              i=$((i + 1))
              ;;
            -*)
              if option_takes_no_value "$arg"; then
                i=$((i + 1))
              elif option_takes_value "$arg" && (( i + 1 < ${#args[@]} )); then
                i=$((i + 2))
              else
                saw_ambiguous_option=1
                i=$((i + 1))
              fi
              ;;
            resume)
              find_session_id_after_resume_command "${args[@]:$((i + 1))}"
              return
              ;;
            *)
              if (( saw_ambiguous_option )); then
                saw_ambiguous_option=0
                i=$((i + 1))
                continue
              fi
              return 1
              ;;
          esac
        done
        return 1
        ;;
      resume|fork)
        find_session_id_after_resume_command "${args[@]:$((i + 1))}"
        return
        ;;
      *)
        if (( saw_ambiguous_option )); then
          saw_ambiguous_option=0
          i=$((i + 1))
          continue
        fi
        return 1
        ;;
    esac
  done
  return 1
}

preflight_second_resume() {
  local session_id
  session_id="$(find_resume_session_arg "$@" || true)"
  [[ -n "$session_id" ]] || return 0
  session_file_exists_for_home "$B_HOME" "$session_id" && return 0
  if session_file_exists_for_home "$A_HOME" "$session_id"; then
    import_primary_session_to_second "$session_id"
    return 0
  fi
  return 0
}

handoff_session() {
  local requested="--last"
  local explicit_last=0
  local cwd_filter=""
  while (( $# > 0 )); do
    case "$1" in
      --cwd)
        if (( $# < 2 )); then
          echo "usage: second-codex handoff [SESSION_ID|--last] [--cwd PATH]" >&2
          return 64
        fi
        cwd_filter="$2"
        shift 2
        ;;
      --last)
        if [[ "$requested" != "--last" ]]; then
          echo "second-codex handoff: cannot combine an explicit session id with --last" >&2
          return 64
        fi
        explicit_last=1
        requested="--last"
        shift
        ;;
      -*)
        echo "usage: second-codex handoff [SESSION_ID|--last] [--cwd PATH]" >&2
        return 64
        ;;
      *)
        if [[ "$requested" != "--last" || "$explicit_last" == "1" ]]; then
          if [[ "$explicit_last" == "1" ]]; then
            echo "second-codex handoff: cannot combine an explicit session id with --last" >&2
          else
            echo "usage: second-codex handoff [SESSION_ID|--last] [--cwd PATH]" >&2
          fi
          return 64
        fi
        requested="$1"
        shift
        ;;
    esac
  done

  if [[ "$requested" != "--last" && -n "$cwd_filter" ]]; then
    echo "second-codex handoff cannot combine an explicit session id with --cwd" >&2
    return 64
  fi

  local session_id
  case "$requested" in
    ""|--last)
      session_id="$(latest_session_id_for_home "$B_HOME" "$cwd_filter")"
      ;;
    *)
      session_id="$requested"
      ;;
  esac
  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi

  local primary_session_file
  refuse_symlinked_history_target "$A_HOME" "primary" || return $?
  primary_session_file="$(copy_session_between_homes "$B_HOME" "$A_HOME" "$session_id" "second account" "primary")"
  append_primary_history_line "$session_id"

  cat <<EOF
second-codex handoff
session_id=$session_id
copied_session=$primary_session_file
resume_primary_interactive=codex resume $session_id
resume_primary_exec=codex exec resume $session_id
resume_second_interactive=second-codex resume $session_id
EOF
}

run_session_converter() {
  # Internal helper for handoff-to-claude / handoff-from-claude.
  # Unlike the `handoff` subcommand, the converter does not read or modify
  # Codex home configs; it only reads the source session and writes a single
  # new session file at the receiver's canonical session path. The manifest
  # guard (guard_manifest_homes) is therefore not invoked from the dispatcher.
  # $1 = converter direction (codex-to-claude | claude-to-codex)
  # $2 = subcommand name (for error messages)
  # remaining args are forwarded after the session id is parsed
  local direction="$1"
  local cmd_name="$2"
  shift 2

  local usage
  if [[ "$direction" == "claude-to-codex" ]]; then
    usage="usage: second-codex $cmd_name <session-id> [--target-cwd PATH] [--codex-approval-policy {untrusted|on-request|on-failure|never}] [--codex-sandbox-policy {read-only|workspace-write|danger-full-access}]"
  else
    usage="usage: second-codex $cmd_name <session-id> [--target-cwd PATH]"
  fi
  local session_id=""
  local target_cwd=""
  local codex_approval_policy=""
  local codex_sandbox_policy=""
  while (( $# > 0 )); do
    case "$1" in
      -h|--help)
        echo "$usage"
        return 0
        ;;
      --target-cwd)
        if (( $# < 2 )); then
          echo "$usage" >&2
          return 64
        fi
        if [[ -n "$target_cwd" ]]; then
          echo "second-codex $cmd_name: --target-cwd specified twice" >&2
          return 64
        fi
        # Reject empty / whitespace-only values so user intent is not
        # silently dropped when `--target-cwd ""` (or `"   "`, or a single
        # Unicode NBSP) is passed. Python would otherwise fall through to
        # the source/runtime cwd. Bash 3.2's [[:space:]] only matches
        # ASCII whitespace, so we shell out to Python's str.strip() to
        # match the converter's stricter Unicode-aware check at this
        # boundary too — keeping both layers semantically identical.
        if ! python3 -c 'import sys; sys.exit(0 if sys.argv[1].strip() else 1)' "$2"; then
          echo "second-codex $cmd_name: --target-cwd value must not be empty or whitespace-only" >&2
          return 64
        fi
        # Reject flag-shaped values so something like
        # `--target-cwd --foo UUID` does not silently treat --foo as the cwd.
        if [[ "$2" == -* ]]; then
          echo "second-codex $cmd_name: --target-cwd value must not start with '-'" >&2
          return 64
        fi
        target_cwd="$2"
        shift 2
        ;;
      --codex-approval-policy)
        # Only meaningful for claude-to-codex (codex-to-claude doesn't write
        # a turn_context). Reject early on the wrong direction so the user
        # sees a usage-shape error instead of an argparse error forwarded
        # from python3.
        if [[ "$direction" != "claude-to-codex" ]]; then
          echo "second-codex $cmd_name: --codex-approval-policy is only valid on handoff-from-claude" >&2
          return 64
        fi
        if (( $# < 2 )); then
          echo "$usage" >&2
          return 64
        fi
        if [[ -n "$codex_approval_policy" ]]; then
          echo "second-codex $cmd_name: --codex-approval-policy specified twice" >&2
          return 64
        fi
        case "$2" in
          untrusted|on-request|on-failure|never) ;;
          *)
            echo "second-codex $cmd_name: --codex-approval-policy must be one of {untrusted, on-request, on-failure, never}; got '$2'" >&2
            return 64
            ;;
        esac
        codex_approval_policy="$2"
        shift 2
        ;;
      --codex-sandbox-policy)
        if [[ "$direction" != "claude-to-codex" ]]; then
          echo "second-codex $cmd_name: --codex-sandbox-policy is only valid on handoff-from-claude" >&2
          return 64
        fi
        if (( $# < 2 )); then
          echo "$usage" >&2
          return 64
        fi
        if [[ -n "$codex_sandbox_policy" ]]; then
          echo "second-codex $cmd_name: --codex-sandbox-policy specified twice" >&2
          return 64
        fi
        case "$2" in
          read-only|workspace-write|danger-full-access) ;;
          *)
            echo "second-codex $cmd_name: --codex-sandbox-policy must be one of {read-only, workspace-write, danger-full-access}; got '$2'" >&2
            return 64
            ;;
        esac
        codex_sandbox_policy="$2"
        shift 2
        ;;
      -*)
        echo "$usage" >&2
        return 64
        ;;
      *)
        if [[ -n "$session_id" ]]; then
          echo "$usage" >&2
          return 64
        fi
        session_id="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$session_id" ]]; then
    echo "$usage" >&2
    return 64
  fi

  if ! is_valid_session_id "$session_id"; then
    echo "second-codex refused malformed session id: $session_id" >&2
    return 64
  fi

  if [[ "${SECOND_CODEX_TEST_DISABLE_PYTHON3:-0}" == "1" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "second-codex $cmd_name requires python3" >&2
    return 70
  fi

  local script_dir converter
  script_dir="$(dirname "$WRAPPER_PATH")"
  converter="$script_dir/lib/session_convert.py"
  if [[ ! -f "$converter" ]]; then
    echo "second-codex: converter script missing: $converter" >&2
    return 70
  fi

  # Build args. Enum validation for the codex policy flags lives in Python
  # (argparse `choices=`); the wrapper just forwards values verbatim. An
  # invalid value surfaces as a Python argparse error with exit 2 instead
  # of the wrapper's exit 64 — accepted asymmetry to keep the validation
  # source-of-truth in one place.
  local -a converter_args=("$direction" "$session_id")
  if [[ -n "$target_cwd" ]]; then
    converter_args+=(--target-cwd "$target_cwd")
  fi
  if [[ -n "$codex_approval_policy" ]]; then
    converter_args+=(--codex-approval-policy "$codex_approval_policy")
  fi
  if [[ -n "$codex_sandbox_policy" ]]; then
    converter_args+=(--codex-sandbox-policy "$codex_sandbox_policy")
  fi
  python3 "$converter" "${converter_args[@]}"
}

handoff_to_claude() {
  run_session_converter codex-to-claude handoff-to-claude "$@"
}

handoff_from_claude() {
  run_session_converter claude-to-codex handoff-from-claude "$@"
}

session_hint() {
  local account="${1:-}"
  local cwd_filter="${2:-}"
  local home label resume_primary resume_second handoff session_id
  case "$account" in
    primary)
      home="$A_HOME"
      label="codex"
      ;;
    second)
      home="$B_HOME"
      label="second-codex"
      ;;
    *)
      echo "usage: second-codex _session-hint primary|second [CWD]" >&2
      return 64
      ;;
  esac

  local hint_error
  hint_error="$(mktemp "${TMPDIR:-/tmp}/second-codex-hint.XXXXXX")"
  trap 'rm -f "$hint_error"' RETURN
  session_id="$(latest_session_id_for_home "$home" "$cwd_filter" 2>"$hint_error" || true)"
  if [[ -z "$session_id" ]] && grep -q "python3 not found" "$hint_error"; then
    cat "$hint_error"
  fi
  rm -f "$hint_error"
  trap - RETURN
  [[ -n "$session_id" ]] || return 0
  resume_primary="codex resume $session_id"
  resume_second="second-codex resume $session_id"
  handoff="second-codex handoff $session_id && $resume_primary"
  if [[ "$account" == "primary" ]]; then
    printf '\n%s session_id=%s\nresume_primary=%s\nresume_second=%s\n' "$label" "$session_id" "$resume_primary" "$resume_second"
  else
    printf '\n%s session_id=%s\nresume_second=%s\nhandoff_to_primary=%s\n' "$label" "$session_id" "$resume_second" "$handoff"
  fi
}

ensure_shim() {
  refuse_symlink_home "shim" "$BIN_DIR" "directory" || return $?
  if [[ -L "$BIN_DIR" ]]; then
    echo "second-codex refused to use symlinked shim directory: $BIN_DIR" >&2
    return 73
  fi
  (umask 077; mkdir -p "$BIN_DIR")
  chmod 700 "$BIN_DIR"
  local owner_uid
  owner_uid="$(stat -f '%u' "$BIN_DIR" 2>/dev/null || stat -c '%u' "$BIN_DIR")"
  if [[ "$owner_uid" != "$(id -u)" ]]; then
    echo "second-codex refused shim directory not owned by current user: $BIN_DIR" >&2
    return 73
  fi
  local mode
  mode="$(stat -f '%Lp' "$BIN_DIR" 2>/dev/null || stat -c '%a' "$BIN_DIR")"
  if [[ "$mode" != "700" ]]; then
    echo "second-codex refused shim directory with unsafe mode $mode: $BIN_DIR" >&2
    return 73
  fi
  if [[ -n "$REAL_CODEX" && "$REAL_CODEX" == "$BIN_DIR/codex" ]]; then
    echo "second-codex refused recursive codex shim resolution: $REAL_CODEX; set SECOND_CODEX_SWITCH_REAL_CODEX to the real codex binary or remove the stale shim from PATH" >&2
    return 69
  fi
  local tmp_shim
  tmp_shim="$(umask 077; mktemp "$BIN_DIR/codex.XXXXXX")"
  cat > "$tmp_shim" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exec "${SECOND_CODEX_SWITCH_WRAPPER:?missing SECOND_CODEX_SWITCH_WRAPPER}" "$@"
EOF
  chmod 700 "$tmp_shim"
  mv "$tmp_shim" "$BIN_DIR/codex"
}

auth_status() {
  local auth_file="$1/auth.json"
  [[ -f "$auth_file" ]] || { echo "not logged in"; return 0; }
  [[ -s "$auth_file" ]] || { echo "corrupt auth file"; return 0; }
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$auth_file" <<'PY' >/dev/null 2>&1 || { echo "corrupt auth file"; return 0; }
import json, sys
from pathlib import Path
json.loads(Path(sys.argv[1]).read_text())
PY
  fi
  if [[ "${SECOND_CODEX_DOCTOR_SHOW_EMAIL:-0}" != "1" ]]; then
    echo "logged in"
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "logged in (python3 missing)"
    return 0
  fi
  python3 - "$auth_file" <<'PY' 2>/dev/null || echo "unknown"
import base64, json, sys
from pathlib import Path
try:
    data = json.loads(Path(sys.argv[1]).read_text())
    token = (data.get("tokens") or {}).get("id_token") or ""
    if token.count(".") < 2:
        print("unknown")
        raise SystemExit
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode(payload))
    print(claims.get("email") or "unknown")
except Exception:
    print("unknown")
PY
}

doctor_command_is_blocked() {
  local output_file="$1"
  shift
  : > "$output_file"
  if SECOND_CODEX_DOCTOR_INTERNAL=1 "$WRAPPER_PATH" "$@" >"$output_file" 2>&1; then
    return 1
  fi
  grep -q "refused this account/auth command" "$output_file"
}

doctor() {
  local failed=0
  echo "second-codex doctor"
  echo "primary_home=$A_HOME"
  echo "second_home=$B_HOME"
  echo "shim_dir=$BIN_DIR"
  echo "primary_auth=$(auth_status "$A_HOME")"
  echo "second_auth=$(auth_status "$B_HOME")"

  local unknown
  unknown="$(unknown_entries "$A_HOME")"
  if [[ -n "$unknown" ]]; then
    echo "FAIL unknown primary CODEX_HOME entries:"
    printf '%s\n' "$unknown" | sed 's/^/  - /'
    failed=1
  else
    echo "PASS no unknown primary CODEX_HOME entries"
  fi

  unknown="$(unknown_entries "$B_HOME")"
  if [[ -n "$unknown" ]]; then
    echo "FAIL unknown second CODEX_HOME entries:"
    printf '%s\n' "$unknown" | sed 's/^/  - /'
    failed=1
  else
    echo "PASS no unknown second CODEX_HOME entries"
  fi

  if [[ -L "$B_HOME/memories" && "$(readlink "$B_HOME/memories")" == "$A_HOME/memories" ]]; then
    echo "PASS memories symlink to primary"
  else
    echo "FAIL memories is not a symlink to primary"
    failed=1
  fi

  if [[ -L "$B_HOME/memories_extensions" && "$(readlink "$B_HOME/memories_extensions")" == "$A_HOME/memories_extensions" ]]; then
    echo "PASS memories_extensions symlink to primary"
  else
    echo "FAIL memories_extensions is not a symlink to primary"
    failed=1
  fi

  ensure_shim || failed=1
  if [[ -x "$BIN_DIR/codex" && ! -L "$BIN_DIR" && ! -L "$BIN_DIR/codex" ]]; then
    echo "PASS shim exists in owned non-symlink directory"
  else
    echo "FAIL shim missing or unsafe"
    failed=1
  fi

  local block_out=""
  block_out="$(mktemp "${TMPDIR:-/tmp}/second-codex-doctor.XXXXXX")"
  trap 'rm -f "${block_out:-}"' RETURN
  local blocked_ok=1
  doctor_command_is_blocked "$block_out" login || blocked_ok=0
  doctor_command_is_blocked "$block_out" logout || blocked_ok=0
  doctor_command_is_blocked "$block_out" update || blocked_ok=0
  doctor_command_is_blocked "$block_out" plugin login || blocked_ok=0
  doctor_command_is_blocked "$block_out" mcp oauth || blocked_ok=0
  doctor_command_is_blocked "$block_out" mcp -- oauth || blocked_ok=0
  doctor_command_is_blocked "$block_out" --unk1 v1 unk2 login || blocked_ok=0
  doctor_command_is_blocked "$block_out" --unk1 v1 unk2 mcp oauth || blocked_ok=0
  doctor_command_is_blocked "$block_out" exec --login=foo prompt || blocked_ok=0
  doctor_command_is_blocked "$block_out" mcp add --login=user server || blocked_ok=0
  if (( blocked_ok )); then
    echo "PASS account/auth command blocked"
  else
    echo "FAIL account/auth command was not blocked consistently"
    failed=1
  fi
  rm -f "$block_out"
  block_out=""
  trap - RETURN

  return "$failed"
}

main() {
  case "${1:-}" in
    account)
      account_status
      return
      ;;
    usage)
      shift
      usage_status "$@"
      return
      ;;
    _session-hint)
      shift
      guard_home_roots
      session_hint "$@"
      return
      ;;
    handoff)
      shift
      guard_manifest_homes
      handoff_session "$@"
      return
      ;;
    handoff-to-claude)
      shift
      handoff_to_claude "$@"
      return
      ;;
    handoff-from-claude)
      shift
      handoff_from_claude "$@"
      return
      ;;
    session-id)
      shift
      guard_manifest_homes
      case "${1:-}" in
        --primary)
          if [[ "${2:-}" == --* ]]; then
            echo "usage: second-codex session-id [--primary|--second] [CWD]" >&2
            return 64
          fi
          latest_session_id_for_home "$A_HOME" "${2:-}"
          ;;
        --second|"")
          if [[ "${2:-}" == --* ]]; then
            echo "usage: second-codex session-id [--primary|--second] [CWD]" >&2
            return 64
          fi
          latest_session_id_for_home "$B_HOME" "${2:-}"
          ;;
        -*)
          echo "usage: second-codex session-id [--primary|--second] [CWD]" >&2
          return 64
          ;;
        *)
          latest_session_id_for_home "$B_HOME" "$1"
          ;;
      esac
      return
      ;;
  esac

  load_manifest
  guard_home_roots

  if [[ "${1:-}" == "doctor" ]]; then
    doctor
    return
  fi

  if [[ "${SECOND_CODEX_DOCTOR_INTERNAL:-0}" != "1" ]]; then
    ensure_shared_paths
    ensure_shim
  fi

  local classification
  classification="$(classify_command "$@")"

  if [[ "$classification" == "block" ]]; then
    block_reason
    return 64
  fi

  require_runtime_dependencies "$classification"

  if [[ "$classification" == "second" ]]; then
    preflight_second_resume "$@"
  fi

  sync_projection
  case "$classification" in
    reroute)
      reroute_notice
      local rc=0 sync_rc=0
      CODEX_ACCOUNT_SLOT=primary \
        SECOND_CODEX_ACTIVE_ACCOUNT=primary \
        CODEX_HOME="$A_HOME" \
        "$REAL_CODEX" "$@" || rc=$?
      sync_projection || sync_rc=$?
      if (( rc != 0 )); then
        return "$rc"
      fi
      if (( sync_rc != 0 )); then
        return "$sync_rc"
      fi
      return "$rc"
      ;;
    second)
      SECOND_CODEX_SWITCH_WRAPPER="$WRAPPER_PATH" \
        SECOND_CODEX_SWITCH_REAL_CODEX="$REAL_CODEX" \
        PATH="$BIN_DIR:$PATH" \
        CODEX_HOME="$B_HOME" \
        CODEX_ACCOUNT_SLOT=second \
        SECOND_CODEX_ACTIVE_ACCOUNT=second \
        "$REAL_CODEX" "$@"
      ;;
    *)
      echo "second-codex internal error: unknown command classification '$classification'" >&2
      return 70
      ;;
  esac
}

main "$@"
